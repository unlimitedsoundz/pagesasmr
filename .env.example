# ASMR Creator Platform (Pages) - Environment Configuration

# Next.js Server
PORT=3001
NEXT_PUBLIC_APP_URL=https://pages.pinkroom.online
NEXT_PUBLIC_PLATFORM_ID=pinkroom_pages
NEXT_PUBLIC_CONTENT_CATEGORY=page_turning

# Platform Business Rules
NEXT_PUBLIC_RATE_PER_VIDEO=50.00
NEXT_PUBLIC_MIN_PAYOUT_VIDEOS=8
MIN_VIDEO_DURATION_SECONDS=180
MAX_UPLOAD_SIZE_BYTES=524288000 # 500 MB

# Storage Architecture: 'hostinger' | 'supabase' | 'r2'
# Set to 'hostinger' to route new video uploads to persistent Hostinger storage (bypassing Supabase size limits)
# Set to 'supabase' to instantly rollback new uploads to Supabase storage buckets
STORAGE_PROVIDER=hostinger
NEXT_PUBLIC_MEDIA_URL=https://media.pinkroom.online

# Local / Hostinger Storage Directory for Private Videos
LOCAL_MEDIA_DIR=/home/u533744278/media/private-videos
MEDIA_PREVIEW_DIR=/home/u533744278/media/previews
UPLOAD_TEMP_DIR=/home/u533744278/media/tmp

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=private-videos

# Payout Provider Boundary
PAYOUT_PROVIDER_MODE=manual # 'manual' | 'wise' | 'stripe'

# Resend Email Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=The Pink Room Pages <notifications@pages.pinkroom.online>
RESEND_REPLY_TO=opheliaadeleke@gmail.com
ADMIN_NOTIFICATION_EMAIL=opheliaadeleke@gmail.com

# Telegram Instant Auto-Forwarding
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Storj / S3 Storage Configuration
S3_ENDPOINT=https://gateway.storjshare.io
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=private-videos

# Korapay NUBAN Account Resolution (Nigerian Interbank)
KORAPAY_SECRET_KEY=wkra_your_korapay_secret_key
KORAPAY_ENCRYPTION_KEY=your_korapay_encryption_key

# Paystack & Flutterwave NUBAN Account Resolution (Alternative)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_your_flutterwave_secret_key
