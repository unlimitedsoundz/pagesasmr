# ASMR Creator Platform - Environment Configuration

# Next.js Server
PORT=3000
NEXT_PUBLIC_APP_URL=https://pinkroom.online

# Platform Business Rules
NEXT_PUBLIC_RATE_PER_VIDEO=50.00
NEXT_PUBLIC_MIN_PAYOUT_VIDEOS=8
MIN_VIDEO_DURATION_SECONDS=180
MAX_UPLOAD_SIZE_BYTES=524288000 # 500 MB

# Local Storage Directory for Private Videos
LOCAL_MEDIA_DIR=./uploads

# Supabase Configuration (Optional - platform runs out of the box with local persistent DB)
# When deploying to Supabase, provide these variables:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=private-videos

# Payout Provider Boundary (Optional)
# If empty, platform operates in verified manual transfer ledger mode with reference IDs
PAYOUT_PROVIDER_MODE=manual # 'manual' | 'wise' | 'stripe'

# Resend Email Configuration (Edge Functions & Transactional Alerts)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=The Pink Room <notifications@pinkroom.online>
ADMIN_NOTIFICATION_EMAIL=unlymitedsoundz@gmail.com

# Telegram Instant Auto-Forwarding (Instant Alerts for Videos & Audition Samples)
# Get bot token from @BotFather on Telegram, and Chat ID for your channel or group
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ASMR Creator Platform - Environment Configuration

# Next.js Server
PORT=3000
NEXT_PUBLIC_APP_URL=https://pinkroom.online

# Platform Business Rules
NEXT_PUBLIC_RATE_PER_VIDEO=50.00
NEXT_PUBLIC_MIN_PAYOUT_VIDEOS=8
MIN_VIDEO_DURATION_SECONDS=180
MAX_UPLOAD_SIZE_BYTES=524288000 # 500 MB

# Local Storage Directory for Private Videos
LOCAL_MEDIA_DIR=./uploads

# Supabase Configuration (Optional - platform runs out of the box with local persistent DB)
# When deploying to Supabase, provide these variables:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=private-videos

# Payout Provider Boundary (Optional)
# If empty, platform operates in verified manual transfer ledger mode with reference IDs
PAYOUT_PROVIDER_MODE=manual # 'manual' | 'wise' | 'stripe'

# Resend Email Configuration (Edge Functions & Transactional Alerts)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=The Pink Room <notifications@pinkroom.online>
ADMIN_NOTIFICATION_EMAIL=unlymitedsoundz@gmail.com

# Telegram Instant Auto-Forwarding (Instant Alerts for Videos & Audition Samples)
# Get bot token from @BotFather on Telegram, and Chat ID for your channel or group
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Cloudflare R2 Storage ($0 Egress Bandwidth Fees — Recommended over Supabase)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=private-videos

# Korapay NUBAN Account Resolution (Nigerian Interbank)
KORAPAY_SECRET_KEY=wkra_your_korapay_secret_key
KORAPAY_ENCRYPTION_KEY=your_korapay_encryption_key

# Paystack & Flutterwave NUBAN Account Resolution (Alternative)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_your_flutterwave_secret_key
